POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=checklistdb
API_PORT=8080
DB_URL=jdbc:postgresql://db:5432/${POSTGRES_DB}

# ===========================================
# CONFIGURACIÓN DEL SISTEMA DE AGENTES IA
# ===========================================

# Modelo por defecto para agentes (sonnet, haiku, opus)
DEFAULT_AGENT_MODEL=sonnet

# Temperatura por defecto (0.0 - 1.0)
DEFAULT_TEMPERATURE=0.7

# Timeout para operaciones de agentes (segundos)
AGENT_OPERATION_TIMEOUT=300

# Directorios del proyecto
BACKEND_DIR=services/api
FRONTEND_DIR=apps/web
MEMORY_DIR=memory
CONTEXT_DIR=context

# Comandos de build y test
BACKEND_BUILD_CMD=./gradlew clean build
BACKEND_TEST_CMD=./gradlew test
BACKEND_RUN_CMD=./gradlew bootRun
FRONTEND_BUILD_CMD=npm run build
FRONTEND_TEST_CMD=npm test
FRONTEND_RUN_CMD=npm start

# Integraciones opcionales (para futuro)
GITHUB_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
AGENT_LOG_FILE=.claude/agents.log

# Límites y umbrales
MIN_TEST_COVERAGE=80
MIN_CODE_COVERAGE=70
MAX_BUGS_ALLOWED=0

# Características experimentales
QUALITY_GATE_ENABLED=true
PARALLEL_EXECUTION=false
AUTO_COMMIT=false
